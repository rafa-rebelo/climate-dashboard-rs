# ══════════════════════════════════════════════════════
#  Sistema Autônomo de Análise Climática — RS
#  Copie este arquivo para .env e preencha os valores
#  NUNCA commite o arquivo .env no GitHub
# ══════════════════════════════════════════════════════

# ── APIs de dados meteorológicos ─────────────────────
ANA_TOKEN=seu_token_aqui
INMET_TOKEN=seu_token_aqui
REDEMET_KEY=sua_chave_aqui
NASA_USER=seu_usuario_earthdata
NASA_PASS=sua_senha_earthdata

# ── Alertas ───────────────────────────────────────────
TELEGRAM_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# ── GitHub (para commits automáticos via Actions) ─────
GH_TOKEN=seu_personal_access_token

# ── Banco de dados ────────────────────────────────────
DB_PATH=data/climate.duckdb

# ── Dashboard ─────────────────────────────────────────
DASHBOARD_TITLE=Monitor Hidrometeorológico RS
PRIMARY_STATE=RS

# ── CEMADEN (pluviômetros ~10 min) ────────────────────
# Rota oficial: cadastro gratuito no CEMADEN → token SGAA automático
CEMADEN_EMAIL=seu_email_cadastrado_no_cemaden
CEMADEN_PASSWORD=sua_senha_cemaden
# Fallback: URL JSON aberta do mapa interativo (DevTools → Network)
CEMADEN_DADOS_URL=
